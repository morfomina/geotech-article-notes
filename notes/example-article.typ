// ============================================================
// Конспект научной статьи — шаблон
// геотехника / виброползучесть
// ============================================================

#set page(
  paper: "a4",
  margin: (top: 2cm, bottom: 2cm, left: 2.5cm, right: 2cm),
)
#set text(font: "Libertinus Serif", size: 11pt, lang: "ru")
#set par(justify: true, leading: 0.6em)

#let todo(body) = text(fill: gray, style: "italic", body)

#let place(title) = {
  box(
    inset: (x: 6pt, y: 3pt),
    fill: rgb("#e8edf3"),
    radius: 4pt,
    strong(title),
  )
}

#let fill-line(label, content) = {
  grid(
    columns: (17%, 83%),
    column-gutter: 6pt,
    align(horizon, text(weight: "bold")[#label:]),
    content,
  )
}

#let field(name, body) = {
  v(4pt)
  place(name)
  v(4pt)
  body
  v(8pt)
}

// ============================================================
// Данные статьи — заполни ниже
// ============================================================

#set heading(numbering: none)

#align(center, text(size: 16pt, weight: "bold")[Конспект научной статьи])
#v(4pt)
#align(center, text(size: 10pt, fill: gray)[инженер-геотехник · магистратура · виброползучесть])
#v(12pt)

// ----- base -----

#field("Название статьи")[
  #todo[впишите название статьи]
]

#field("Авторы")[
  #todo[впишите авторов]
]

#field("Журнал / конференция · Год")[
  #todo[впишите источник и год]
]

#field("DOI / ссылка")[
  #todo[впишите DOI или ссылку]
]

// ----- reading context -----

#field("Дата чтения")[
  #todo[впишите дату]
]

#field("Статус")[
  #todo[прочитано / требуется перечитать / только abstract]
]

#field("Ключевые слова (от авторов + свои теги)")[
  #todo[vibrocreep, cyclic loading, sandy soil, excess pore pressure …]
]

// ----- summary -----

#field("Главная мысль автора (1–3 предложения)")[
  #todo[что именно утверждает или доказывает статья?]
]

#field("Исследовательский вопрос / гипотеза")[
  #todo[какой пробел в знаниях закрывают? Что именно хотели выяснить?]
]

#field("Тип работы")[
  #todo[экспериментальная / численное моделирование / аналитическая / обзор / полевая]
]

// ----- method -----

#field("Методология")[
  #todo[приборы, установка, софт, модель грунта, граничные условия …]
]

#field("Исследуемый материал / грунт")[
  #todo[песок, глина, суглинок; характеристики: плотность, влажность, гранулометрия …]
]

#field("Режим нагружения / параметры вибрации")[
  #todo[частота, амплитуда, количество циклов, дренированные / недренированные условия …]
]

// ----- results -----

#field("Доводы автора (основные аргументы / логическая цепочка)")[
  #todo[как автор пришёл к выводу? Какие промежуточные шаги?]
]

#field("Ключевые результаты (цифры, графики, таблицы)")[
  #todo[что конкретно получено? Запиши ВАЖНЫЕ цифры и диапазоны.]
]

#field("Сравнение с другими работами")[
  #todo[с кем сравнивают? Согласуется или противоречит?]
]

// ----- critique & reflection -----

#field("Сильные стороны")[
  #todo[что сделано особенно хорошо?]
]

#field("Слабые стороны / ограничения")[
  #todo[малая выборка? Упрощённая модель? Не учтены факторы X, Y?]
]

#field("Мои мысли / критика")[
  #todo[что я об этом думаю? Где можно применить? Как связано с моей темой виброползучести?]
]

#field("Открытые вопросы после прочтения")[
  #todo[что осталось непонятным? Что хотелось бы исследовать дальше?]
]

// ----- practical relevance -----

#field("Применимость к моей работе")[
  #todo[можно ли сослаться? Подтверждает ли мою гипотезу? Даёт ли метод, который я могу использовать?]
]

#field("Оценка (1–5)")[
  #todo[общая полезность для диссертации]
]

#field("Следующие статьи к прочтению (из references)")[
  #todo[какие источники из списка литературы стоит прочитать?]
]

// ============================================================
// Краткая карточка для быстрого обзора
// ============================================================

#pagebreak()
#set text(size: 10pt)

#align(center, text(size: 14pt, weight: "bold")[Краткая карточка])
#v(8pt)

#fill-line[Статья:][#todo[название]]
#fill-line[Главная мысль:][#todo[1 предложение]]
#fill-line[Метод:][#todo[1 строка]]
#fill-line[Ключевой результат:][#todo[1 строка]]
#fill-line[Полезность:][#todo[★★★☆☆]]

#v(12pt)
#box(
  inset: 10pt,
  fill: rgb("#f4f4f4"),
  radius: 4pt,
  [
    *Как вести конспекты:* \
    — Заполняй сразу после чтения, пока свежо. \
    — Не копируй абстракт, пиши *своими словами*. \
    — Если статья не по теме — заполни только блок «Главная мысль» и «Применимость»; остальное можно пропустить. \
    — Сортируй конспекты по тегам (vibrocreep / cyclic / experimental / FE-modeling / …). \
  ],
)